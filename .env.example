# Public Monad testnet configuration.
EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPO_PUBLIC_MONAD_CHAIN_ID=10143
EXPO_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadscan.com

# Agora AUSD on Monad testnet.
EXPO_PUBLIC_AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
EXPO_PUBLIC_AUSD_DECIMALS=6
EXPO_PUBLIC_AUSD_FAUCET_ADDRESS=0xd236c18D274E54FAccC3dd9DDA4b27965a73ee6C

# Phase 6 privacy-safe correlation registry deployed on Monad testnet.
EXPO_PUBLIC_SETTLEMENT_REGISTRY_ADDRESS=0xdcB418C6e719C40c8e1F9B446cD850330219EEFf

# Phase 8 stable public GraphQL proxy for the active Envio Development deployment.
# Never place ENVIO_API_TOKEN or another secret in an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_ENVIO_GRAPHQL_URL=https://metropolis.cherrymoney.co.uk/graphql/

# Live HyperSync observations use the existing Cherry Money backend.
# Set ENVIO_API_TOKEN and ENVIO_HYPERSYNC_ENABLED only in that server runtime.
# For isolated testing, point this URL at the deployed testing backend instead.
EXPO_PUBLIC_ENVIO_HYPERSYNC_URL=https://cherrymoney.co.uk/api/envio/hypersync

# Existing Cherry Money backend remains the business/accounting system of record.
EXPO_PUBLIC_CHERRY_MONEY_API_BASE_URL=https://cherrymoney.co.uk

# Native build-time Mera relying-party domain.
MERA_RP_ID=metropolis.cherrymoney.co.uk

# Experimental consumer testnet contracts. Leave writes disabled until reviewed.
# Addresses must come from verified deployment artifacts, never guessed.
EXPO_PUBLIC_CONSUMER_PAYMENTS_ENABLED=false
EXPO_PUBLIC_CONSUMER_GIFT_ADDRESS=
EXPO_PUBLIC_CONSUMER_STREAM_ADDRESS=
EXPO_PUBLIC_CONSUMER_REWARDS_ADDRESS=

# Aurora Intents Connect — public client configuration only.
# Keep false until the Cherry Money proxy is deployed with its API key.
EXPO_PUBLIC_AURORA_INTENTS_ENABLED=false
# The priced API key is held by the Cherry Money server-side proxy.
EXPO_PUBLIC_AURORA_INTENTS_API_BASE_URL=https://intents-connect-alpha-api.aurora.dev
EXPO_PUBLIC_AURORA_INTENTS_PROXY_URL=https://cherrymoney.co.uk/api/aurora-intents/
EXPO_PUBLIC_AURORA_BASE_RPC_URL=https://mainnet.base.org
EXPO_PUBLIC_MONAD_MAINNET_EXPLORER_URL=https://monadscan.com
