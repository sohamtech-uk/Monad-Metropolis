# Used for local HyperSync access. Envio Cloud has managed HyperSync access.
ENVIO_API_TOKEN=

# Public trust anchor for the deployed Monad Testnet registry.
# Envio Cloud custom variables must use an ENVIO_ prefix.
ENVIO_CHERRY_SETTLEMENT_REGISTRY_ADDRESS=0xdcB418C6e719C40c8e1F9B446cD850330219EEFf

# Optional local-development compatibility name.
CHERRY_SETTLEMENT_REGISTRY_ADDRESS=0xdcB418C6e719C40c8e1F9B446cD850330219EEFf
